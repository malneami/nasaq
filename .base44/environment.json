{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "NEXT_PUBLIC_SUPABASE_URL",
      "description": "Supabase project URL (Project Settings → API)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "description": "Supabase anon key (Project Settings → API)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "SUPABASE_SERVICE_ROLE_KEY",
      "description": "Supabase service role key (Project Settings → API)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "DATABASE_URL",
      "description": "Postgres connection string for Drizzle (Supabase Project Settings → Database, pooled URI)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "ANTHROPIC_API_KEY",
      "description": "Anthropic API key for inbox classification (console.anthropic.com)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "ANTHROPIC_MODEL",
      "description": "Anthropic model identifier (e.g. claude-sonnet-4-20250514)",
      "requiredAtBoot": false,
      "generatedForDevelopment": true
    }
  ]
}
